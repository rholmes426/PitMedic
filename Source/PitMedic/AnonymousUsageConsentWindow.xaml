<Window x:Class="PitMedic.AnonymousUsageConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help improve PitMedic" Icon="Assets/PitMedic.ico"
        Width="550" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Help improve PitMedic" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Help us understand how many people use PitMedic."
                       Foreground="{DynamicResource MutedBrush}" FontSize="15" Margin="0,7,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,22,0,20">
            <StackPanel>
                <TextBlock Text="Share activity and first-launch counts with your PitMedic version. No names, files, or simulator activity are included."
                           TextWrapping="Wrap" LineHeight="23"/>
                <TextBlock Text="Optional. You can change this in Settings at any time."
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Content="Preview exact data" Click="Preview_Click" Margin="0,0,10,0"/>
                    <Button Content="Read privacy policy" Click="Privacy_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Button Content="No thanks" HorizontalAlignment="Left" Click="NoThanks_Click"/>
            <Button Content="Share usage counts" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right" Click="Share_Click"/>
        </Grid>
    </Grid>
</Window>
