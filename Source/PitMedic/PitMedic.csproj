<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>PitMedic</AssemblyName>
    <RootNamespace>PitMedic</RootNamespace>
    <Version>0.6.0.11</Version>
    <AssemblyVersion>0.6.0.11</AssemblyVersion>
    <FileVersion>0.6.0.11</FileVersion>
    <InformationalVersion>0.6.0.11</InformationalVersion>
    <ReleaseChannel Condition="'$(ReleaseChannel)' == ''">preview</ReleaseChannel>
    <AssemblyTitle>PitMedic</AssemblyTitle>
    <Product>PitMedic Sim Racing Diagnostics &amp; Repair</Product>
    <Description>Background simulator monitoring, diagnostics, and guided repair for Le Mans Ultimate, iRacing, Assetto Corsa EVO, RaceRoom Racing Experience, Assetto Corsa Competizione, and Automobilista 2.</Description>
    <Company>PitMedic Project</Company>
    <Authors>PitMedic Project</Authors>
    <Copyright>Copyright (c) 2026 PitMedic contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PitMedic.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="PitMedicReleaseChannel" Value="$(ReleaseChannel)" />
    <Resource Include="Assets\PitMedic.ico" />
    <Resource Include="Assets\PitMedic.png" />
    <EmbeddedResource Include="Assets\RaceRoomCars.json" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.11" />
  </ItemGroup>
</Project>
