<Window x:Class="PitMedic.RepairProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PitMedic Repair" Icon="Assets/PitMedic.ico" Width="690" Height="620" MinWidth="620" MinHeight="560"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontSize="14"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Image Source="Assets/PitMedic.png" Width="42" Height="42" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="PITMEDIC REPAIR" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold"/>
                <TextBlock x:Name="RepairTitle" Text="Repair in progress" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="2" x:Name="StatePill" Background="{DynamicResource GoodSoftBrush}" CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                <TextBlock x:Name="StateText" Text="ACTIVE" Foreground="{DynamicResource GoodTextBrush}" FontSize="12" FontWeight="Bold"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="StageText" Text="Preparing repair" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MessageText" Text="Preparing the repair workspace..." Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="ESTIMATED REMAINING" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="RemainingText" Text="~8 min" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="RepairProgress" Grid.Row="1" Height="9" Margin="0,20,0,0" Minimum="0" Maximum="100" Background="{DynamicResource Panel2Brush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock x:Name="StepText" Text="Step 1 of 5" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="PercentText" Text="2%" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="CURRENT ACTION" Foreground="{DynamicResource InfoTextBrush}" FontSize="12" FontWeight="Bold"/>
                <TextBlock x:Name="DetailText" Text="No game files have been changed yet." Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="REPAIR ACTIVITY" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="ElapsedText" Text="Elapsed 0:00" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                </Grid>
                <ListBox x:Name="ActivityList" Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MaxHeight="220" Padding="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" Margin="2,3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="FooterText" Text="You can leave this window open while PitMedic completes the repair." Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackgroundButton" Content="Run in background" Margin="0,0,10,0" Click="Background_Click"/>
                <Button x:Name="CancelButton" Content="Cancel repair" Foreground="{DynamicResource DangerTextBrush}" Click="Cancel_Click"/>
                <Button x:Name="CloseButton" Content="Close" Visibility="Collapsed" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
