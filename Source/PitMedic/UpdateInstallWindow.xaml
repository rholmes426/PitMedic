<Window x:Class="PitMedic.UpdateInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PitMedic Update" Icon="Assets/PitMedic.ico"
        Width="620" Height="500" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text" FontSize="14">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="PITMEDIC UPDATE" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" FontWeight="Bold"/>
                    <TextBlock x:Name="TitleText" Text="Preparing update" FontFamily="Segoe UI Variable Display" FontSize="29" FontWeight="Bold" Margin="0,7,0,0"/>
                    <TextBlock x:Name="VersionText" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/>
                </StackPanel>

                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Text="Checking the published update package…" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DetailText" Text="PitMedic will download and verify the installer before Windows is asked to install anything." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,6,0,0"/>
                        <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Margin="0,16,0,0" IsIndeterminate="True"/>
                        <TextBlock x:Name="ProgressText" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SafetyBorder" Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                    <TextBlock x:Name="SafetyText" Text="The downloaded installer must match the SHA-256 fingerprint published by PitMedic. If verification fails, the update is blocked." TextWrapping="Wrap" Foreground="{DynamicResource InfoTextBrush}" FontSize="12.5"/>
                </Border>

                <TextBlock x:Name="FooterText" Text="The installer remains unsigned until PitMedic code signing is approved, so Windows may still show a security or administrator approval prompt." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,16,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Padding="14,7" Click="Cancel_Click"/>
            <Button x:Name="InstallButton" Content="Install now" MinWidth="112" Padding="14,7" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="Install_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
