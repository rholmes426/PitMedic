<Window x:Class="PitMedic.AnonymousUsagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anonymous usage data" Icon="Assets/PitMedic.ico"
        Width="650" Height="540" MinWidth="540" MinHeight="440"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Exactly what PitMedic shares" FontFamily="Segoe UI Variable Display" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="The token values below are descriptions. Real tokens are random-looking, change automatically, and never contain personal or device information."
                       Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,7,0,16"/>
        </StackPanel>
        <TextBox x:Name="PayloadText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                 FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="16"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"/>
        <TextBlock Grid.Row="2" Text="Nothing else is attached to this request. Cloudflare processes the network connection, but PitMedic does not store your IP address."
                   Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,14,120,0"/>
        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" Click="Close_Click"/>
    </Grid>
</Window>
