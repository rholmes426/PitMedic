<Window x:Class="PitMedic.RepairPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PitMedic Repair" Icon="Assets/PitMedic.ico" Width="620" Height="560" MinWidth="560" MinHeight="500"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontSize="14"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/PitMedic.png" Width="42" Height="42" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Repair available" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold"/>
                    <TextBlock x:Name="RepairTitle" Text="PitMedic found a repair" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="DiagnosisText" Text="Diagnosis" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,15,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,18">
            <StackPanel>
                <Border x:Name="AffectedContentPanel" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="RECOMMENDED ACTION" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="RepairSummary" TextWrapping="Wrap" FontSize="14" Margin="0,9,18,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12,8" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="ESTIMATED TIME" Foreground="{DynamicResource WarnTextBrush}" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="EstimateText" Text="6–8 min" Foreground="{DynamicResource WarnTextBrush}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="AFFECTED CONTENT" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="Bold"/>
                        <ItemsControl x:Name="AffectedList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="What PitMedic will do" Foreground="{DynamicResource InfoTextBrush}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="RepairBehaviorText" Text="PitMedic follows the listed repair steps, preserves recovery data where the playbook changes files, and records every action with this finding." Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="17"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ReferencePanel" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="REPAIR BASIS" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="Bold"/>
                        <ItemsControl x:Name="ReferenceList" Margin="0,5,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <TextBlock x:Name="ApprovalNote" Text="Because this repair is expected to take more than 2 minutes, PitMedic will only start it with your approval." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Width="330" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Not now" Margin="0,0,10,0" Click="NotNow_Click"/>
                <Button x:Name="RepairNowButton" Style="{StaticResource PrimaryButtonStyle}" Content="Repair now" Click="RepairNow_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
