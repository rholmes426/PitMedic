<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PitMedic.SensorHelper</AssemblyName>
    <RootNamespace>PitMedic.SensorHelper</RootNamespace>
    <Version>1.0.0.1</Version>
    <AssemblyVersion>1.0.0.1</AssemblyVersion>
    <FileVersion>1.0.0.1</FileVersion>
    <InformationalVersion>1.0.0.1</InformationalVersion>
    <AssemblyTitle>PitMedic Read-Only Sensor Service</AssemblyTitle>
    <Product>PitMedic Read-Only Sensor Service</Product>
    <Description>Installer-managed read-only CPU hardware telemetry service for PitMedic.</Description>
    <Company>PitMedic Project</Company>
    <Authors>PitMedic Project</Authors>
    <Copyright>Copyright (c) 2026 PitMedic contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\PitMedic\Assets\PitMedic.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../PitMedic/Services/CpuSensorPolicy.cs" Link="CpuSensorPolicy.cs" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
</Project>
