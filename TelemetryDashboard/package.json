{
  "name": "pitmedic-usage-dashboard",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "wrangler types && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p test/tsconfig.json --noEmit && vitest run",
